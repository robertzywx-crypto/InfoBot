/* ============================================================
   🎨 INFORBOT — CSS FINAL (VERTICAL + NEON + SEM BUG)
   ============================================================ */

/* ================= VARIÁVEIS ================= */
:root {
    --bg: #010409;
    --app: #0d1117;
    --text: #c9d1d9;
    --accent: #1f6feb;
    --border: #30363d;

    --bubble-bot: #161b22;
    --text-bot: #e6edf3;

    --neon-blue: 0 0 8px #1f6feb, 0 0 18px #1f6feb;
    --header: linear-gradient(135deg, #000428, #004e92, #000000);
}

/* ================= MODO CLARO (SEM BUG) ================= */
body.light-mode {
    --bg: #eef2f7;
    --app: #ffffff;
    --text: #0f172a;
    --border: #cfd6e0;

    --bubble-bot: #f3f5f9;
    --text-bot: #0f172a;

    --neon-blue: 0 0 8px #2563eb, 0 0 18px #60a5fa;
    --header: linear-gradient(135deg, #2563eb, #60a5fa);
}

/* ================= RESET ================= */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', sans-serif;
    transition: 0.25s ease;
}

body {
    height: 100vh;
    background: var(--bg);
    display: flex;
    justify-content: center;
    align-items: center;
}

/* ================= APP (SEMPRE VERTICAL) ================= */
.app {
    width: 96%;
    max-width: 1400px;
    height: 96vh;
    background: var(--app);
    border-radius: 28px;
    display: flex;
    flex-direction: column; /* 🔥 SEMPRE PRA BAIXO */
    border: 2px solid var(--border);
    box-shadow: var(--neon-blue);
    overflow: hidden;
}

/* ================= HEADER ================= */
.header {
    background: var(--header);
    padding: 22px;
    text-align: center;
    color: white;
    border-bottom: 2px solid var(--accent);
    box-shadow: var(--neon-blue);
}

.title {
    font-size: 40px;
    font-weight: 900;
    letter-spacing: 10px;
    text-transform: uppercase;
    text-shadow: var(--neon-blue);
    animation: float 3s ease-in-out infinite;
}

@keyframes float {
    0%,100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
}

/* ================= CHAT ================= */
.chat {
    flex: 1;
    padding: 22px;
    overflow-y: auto;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    gap: 14px;
}

/* ================= BOLHAS ================= */
.bubble {
    padding: 14px 20px;
    border-radius: 22px; /* 🔥 SEM QUADRADO */
    font-size: 16px;
    max-width: 80%;
    line-height: 1.5;
}

.bot-msg {
    background: var(--bubble-bot);
    color: var(--text-bot);
    border: 1px solid var(--accent);
    box-shadow: 0 0 10px rgba(31,111,235,.35);
}

.user-msg {
    align-self: flex-end;
    background: var(--accent);
    color: white;
    box-shadow: var(--neon-blue);
}

/* ================= STATUS ================= */
.status {
    display: none;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    font-weight: bold;
    padding: 10px 20px;
}

/* ================= INPUT ================= */
.input-area {
    padding: 14px;
    background: var(--app);
    border-top: 1px solid var(--border);
    display: flex;
    gap: 10px;
    align-items: center;
}

/* CAMPO TEXTO */
input {
    flex: 1;
    padding: 14px 22px;
    border-radius: 30px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    outline: none;
}

input:focus {
    border-color: var(--accent);
    box-shadow: var(--neon-blue);
}

/* ================= BOTÕES (MANTENDO ESTILO ORIGINAL) ================= */
.btn-ui,
.game-btn {
    background: rgba(255,255,255,0.08);
    border: 2px solid white;
    color: white;
    padding: 10px 20px;
    border-radius: 12px;
    cursor: pointer;
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
}

.anim:hover {
    transform: scale(1.25);
    background: var(--accent);
    box-shadow: var(--neon-blue);
}

/* ================= MICROFONE & ENVIAR ================= */
.mic-btn,
.send-btn {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: transparent;
    border: 2px solid var(--accent);
    color: var(--accent);
    cursor: pointer;
}

/* 🔵 CÍRCULO AZUL NEON */
.mic-btn:hover,
.send-btn:hover {
    box-shadow: 0 0 0 5px rgba(31,111,235,0.25), var(--neon-blue);
    transform: scale(1.15);
}

/* ================= ANIMAÇÕES DE JOGO ================= */
@keyframes acerto {
    0% { box-shadow: 0 0 0 #2ecc71; }
    50% { box-shadow: 0 0 30px #2ecc71; }
    100% { box-shadow: 0 0 10px #2ecc71; }
}

@keyframes erro {
    0%,100% { transform: translateX(0); }
    25% { transform: translateX(-10px); }
    75% { transform: translateX(10px); }
}

.msg-acerto {
    animation: acerto 0.6s;
    border: 2px solid #2ecc71;
}

.msg-erro {
    animation: erro 0.5s;
    border: 2px solid #e74c3c;
}

/* ================= PC (SÓ MAIOR) ================= */
@media (min-width: 1024px) {
    .app {
        max-width: 1600px;
        height: 95vh;
    }

    .title {
        font-size: 44px;
    }
}

/* ================= CELULAR ================= */
@media (max-width: 768px) {
    .app {
        width: 100%;
        height: 100%;
        border-radius: 0;
    }

    .title {
        font-size: 28px;
        letter-spacing: 6px;
    }

    .input-area {
        padding-bottom: 22px; /* não cobre teclado */
    }
}

/* ================= IPHONE ================= */
@media (max-width: 430px) {
    .title {
        font-size: 24px;
    }

    input {
        padding: 12px 18px;
    }
}

</style>
