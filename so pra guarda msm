// --- 4. FUNÇÕES DE INTERFACE ---

function autoMessage(t) { document.getElementById("userInput").value = t; send(); }

function setMode(m) {
    if (m === 'light') { document.body.classList.add('light-mode'); botSay("☀️ MODO CLARO", "acerto"); } 
    else { document.body.classList.remove('light-mode'); botSay("🌙 MODO ESCURO"); }
}

function botSay(txt, tipo = "") {
    const chat = document.getElementById("chat");
    const container = document.createElement("div");
    container.className = "bot-msg bubble anim" + (tipo ? " msg-" + tipo : "");
    container.innerHTML = `<small style="opacity:0.5; font-size: 10px;">⚡ [Analysing...]</small><br>${txt}`;
    chat.appendChild(container);
    chat.scrollTop = chat.scrollHeight;

    window.speechSynthesis.cancel();

    // --- LIMPEZA SUPREME PARA A FALA ---
    let falaFiltro = txt
        .replace(/<\/?[^>]+(>|$)/g, "") // Remove tags HTML como <br>
        .replace(/\*/g, "")              // Mata os asteriscos (asterístico nunca mais!)
        .replace(/#/g, "")               // Remove hashtags
        .replace(/(\d+)\s*([\+\-\*\/])\s*(\d+)/g, "$1 $2 $3"); // Dá espaço em contas matemáticas

    const f = new SpeechSynthesisUtterance(falaFiltro);
    
    // --- AJUSTE DE VOZ ---
    f.lang = 'pt-BR';
    f.rate = 1.0;  // Velocidade normal ajuda a falar números grandes melhor
    f.pitch = 1.0; 

    window.speechSynthesis.speak(f);
}

function send() {
    const i = document.getElementById("userInput");
    if (!i.value.trim()) return;
    const val = i.value; i.value = "";
    const d = document.createElement("div"); d.className = "user-msg bubble";
    d.innerHTML = val; document.getElementById("chat").appendChild(d);
    document.getElementById("chat").scrollTop = document.getElementById("chat").scrollHeight;
    analyze(val);
}

